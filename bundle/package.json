{
  "name": "dsh-desk-all",
  "displayName": "卡片桌面全家桶",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "DSH 全家桶聚合包：一次安装卡片桌面（代码工作台）+ 音乐播放器，两个插件可各自独立开关。Cards desktop (code workbench) + music player for DeepSeek Harness, install once, toggle each plugin independently.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "card-desktop",
    "code-workbench",
    "verilog",
    "vivado",
    "music-player"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gqf1/dsh-card-desktop.git",
    "directory": "bundle"
  },
  "homepage": "https://github.com/gqf1/dsh-card-desktop/tree/main/bundle",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-card-desktop": "github:gqf1/dsh-card-desktop",
    "dsh-music-hub": "github:gqf1/dsh-music-hub"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
