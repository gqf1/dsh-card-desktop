      const codeHtml = React.useMemo(() => hlVerilog(text), [text]);
      const selWArr = React.useMemo(() => ((selW && selWStarts.length) ? selWStarts.map((s) => ({ start: s, end: s + selW.length })) : []), [selW, selWStarts]);
      const overlayHtml = React.useMemo(() => {
