        persistWorkspace([]);
        setHierMap({}); setExpandedFolders({}); setExpandedGroups({}); setHierLoading(false); setShowAll(false);
        closeAll();
        setFsStatus("已关闭工作区"); setFsStatusStyle({ color: C.dim });
      };
