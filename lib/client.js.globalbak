      }, []);
      // 跳转到行弹窗（点击状态栏 Ln/Col 打开，VSCode 语义）
      const [goToOpen, setGoToOpen] = React.useState(false);
      const [goToVal, setGoToVal] = React.useState("1");
      const goToJump = () => {
