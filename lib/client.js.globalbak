          setRightActivePath((ra) => {
            if (ra && victimPaths.includes(ra)) {
              const remain = rightPaths.filter(rp => !victimPaths.includes(rp));
              return remain[0] || null;
            }
            return ra;
          });
          setActivePath((cur) => {
