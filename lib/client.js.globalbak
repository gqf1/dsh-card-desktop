          i = j;
          continue;
        }
        out.push(escHtml(ch));
        i++;
      }
      return out.join("");
    };
    const hlVerilog = (text) => {
      const state = { v: false };
      const lines = String(text).split("\n");
      const html = [];
      for (let n = 0; n < lines.length; n++) html.push(hlLine(lines[n], state));
      return html.join("\n");
