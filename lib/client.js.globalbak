      React.createElement("span", { style: { color: "#9d9d9d", fontSize: 11, fontWeight: 600 } }, "找到 " + rows.length + " 个匹配"),
      React.createElement("span", { style: { fontSize: 11, color: "#6a6a6a", flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } }, findQ ? ("\"" + findQ + "\"") : ""),
      React.createElement("button", { onClick: () => op.setResults && op.setResults([]), style: { background: "#3a3d41", color: "#d4d4d4", border: "1px solid #454545", borderRadius: 3, cursor: "pointer", padding: "1px 6px", fontSize: 10 } }, "清空"),
