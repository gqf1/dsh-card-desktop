        const r = [ta.selectionStart, ta.selectionEnd];
        return (r[1] > r[0]) ? r : null; // 无选区返回 null
      };
      // 主查找匹配集：All matching in current scope（当前文档全部匹配，含 In selection 范围）
      const findMatches = React.useMemo(() => {
