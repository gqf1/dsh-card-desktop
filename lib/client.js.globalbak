      /* ---------- ⑨ 多 Tab 查找 / 替换 / 标记 + 底部结果面板 ---------- */
      // 对话框 Tab（Notepad++ Ctrl+F 语义）：find | replace | files | projects | mark
      const [findMode, setFindMode] = React.useState(null); // null = 对话框关闭 | 'find' | 'replace' | 'files' | 'projects' | 'mark'
