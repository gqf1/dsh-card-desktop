    // 相对路径：以工作区内某根目录前缀去除
    const relPathOf = (path, folders) => {
      const p = String(path).replace(/\//g, "\\");
      let best = null;
      (folders || []).forEach((f) => {
        const root = String(f.path).replace(/[\\/]$/, "").replace(/\//g, "\\");
        if (p === root) { best = { root, rel: "" }; return; }
        if (p.toLowerCase().startsWith((root + "\\").toLowerCase())) {
          const cand = p.slice(root.length + 1);
          if (!best || root.length > best.root.length) best = { root, rel: cand };
        }
      });
      return best ? best.rel : p;
    };

    /* ---------------- 高亮（VSCode Dark+ 配色） ---------------- */
    const escHtml = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const KW_SET = {
      module: 1, endmodule: 1, begin: 1, end: 1, if: 1, else: 1, for: 1, while: 1,
      always: 1, initial: 1, assign: 1, case: 1, endcase: 1, default: 1, parameter: 1,
      localparam: 1, genvar: 1, generate: 1, endgenerate: 1, function: 1, endfunction: 1,
      task: 1, endtask: 1, posedge: 1, negedge: 1, or: 1, and: 1, not: 1, repeat: 1,
      fork: 1, join: 1, integer: 1, real: 1, signed: 1, unsigned: 1, timescale: 1,
      wire: 2, reg: 2, logic: 2, input: 2, output: 2, inout: 2, supply0: 2, supply1: 2, tri: 2, wand: 2, wor: 2
    };
    const KW_COLOR = { 1: "#c586c0", 2: "#569cd6" };
    const hlLine = (line, inBlockRef) => {
      const l = line;
      let i = 0;
      const out = [];
      while (i < l.length) {
        const ch = l[i];
        if (inBlockRef.v) {
          const e = l.indexOf("*/", i);
          if (e < 0) { out.push(`<span style="color:#6a9955">${escHtml(l.slice(i))}</span>`); i = l.length; }
          else { out.push(`<span style="color:#6a9955">${escHtml(l.slice(i, e + 2))}</span>`); i = e + 2; inBlockRef.v = false; }
          continue;
        }
        if (ch === "/" && l[i + 1] === "/") { out.push(`<span style="color:#6a9955">${escHtml(l.slice(i))}</span>`); break; }
        if (ch === "/" && l[i + 1] === "*") { inBlockRef.v = true; out.push(`<span style="color:#6a9955">*/</span>`); i += 2; continue; }
        if (ch === '"' || ch === "'") {
          let j = i + 1;
          while (j < l.length && l[j] !== ch && l[j] !== "\\") j++;
          const end = j < l.length ? (l[j] === "\\" ? j + 2 : j + 1) : l.length;
          out.push(`<span style="color:#ce9178">${escHtml(l.slice(i, end))}</span>`);
          i = end;
          continue;
        }
        if (/[A-Za-z_]/.test(ch)) {
          let j = i + 1;
          while (j < l.length && /[A-Za-z0-9_$]/.test(l[j])) j++;
          const w = l.slice(i, j);
          const k = KW_SET[w];
