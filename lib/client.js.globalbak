            onClick: (e) => { if (hasKids) { e.stopPropagation(); setHierExp((prev) => ({ ...prev, [myKey]: !open })); } },
            style: { width: 14, flexShrink: 0, color: hasKids ? "#8a8a8a" : "transparent", fontSize: 10, cursor: hasKids ? "pointer" : "default", textAlign: "center" }
          }, hasKids ? (open ? "▾" : "▸") : "·"),
