      }, [text, hlMatches, findIdx, selWArr, selWIdx, selRange]); // eslint-disable-line react-hooks/exhaustive-deps
      // 高亮层内容刷新后恢复滚动位置：避免选中/滚动后高亮层 scrollTop 被重置导致高亮错位/看不到
      React.useLayoutEffect(() => {
